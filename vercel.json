{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer-when-downgrade"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/xwerse-config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/s/:type/:t",
      "destination": "/api/share?type=:type&t=:t"
    },
    {
      "source": "/Home",
      "destination": "/XwerseMovies_Home.html"
    },
    {
      "source": "/Browse",
      "destination": "/XwerseMovies_Browse.html"
    },
    {
      "source": "/MyList",
      "destination": "/XwerseMovies_MyList.html"
    },
    {
      "source": "/Player",
      "destination": "/XwerseMovies_Player.html"
    },
    {
      "source": "/Search",
      "destination": "/XwerseMovies_Search.html"
    },
    {
      "source": "/Settings",
      "destination": "/XwerseMovies_Settings.html"
    },
    {
      "source": "/GoPremium",
      "destination": "/XwerseMovies_GoPremium.html"
    },
    {
      "source": "/MyPurchases",
      "destination": "/XwerseMovies_MyRequests.html"
    },
    {
      "source": "/Plans",
      "destination": "/XwerseMovies_Plans.html"
    },
    {
      "source": "/Admin",
      "destination": "/XwerseMovies_Admin.html"
    },
    {
      "source": "/Terms",
      "destination": "/XwerseMovies_Terms.html"
    },
    {
      "source": "/Privacy",
      "destination": "/XwerseMovies_Privacy.html"
    },
    {
      "source": "/Refund",
      "destination": "/XwerseMovies_Refund.html"
    },
    {
      "source": "/Delivery",
      "destination": "/XwerseMovies_Delivery.html"
    },
    {
      "source": "/About",
      "destination": "/XwerseMovies_About.html"
    },
    {
      "source": "/Contact",
      "destination": "/XwerseMovies_Contact.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/XwerseMovies_Home.html",
      "destination": "/Home",
      "permanent": true
    },
    {
      "source": "/home",
